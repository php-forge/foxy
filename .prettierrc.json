{
    "tabWidth": 4,
    "useTabs": false,
    "singleQuote": false,
    "trailingComma": "all",
    "printWidth": 80,
    "overrides": [
        {
            "files": ["**/*.{cjs,css,js,mjs,yml,yaml}"],
            "options": {
                "tabWidth": 2
            }
        },
        {
            "files": "**/*.md",
            "options": {
                "embeddedLanguageFormatting": "off",
                "printWidth": 120,
                "proseWrap": "always",
                "tabWidth": 2
            }
        },
        {
            "files": "CHANGELOG.md",
            "options": {
                "proseWrap": "preserve"
            }
        }
    ]
}
